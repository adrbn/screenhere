<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScreenHere</AssemblyName>
    <RootNamespace>ScreenHere</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ScreenHere.ico</ApplicationIcon>
    <Version>1.7.0</Version>
    <Product>ScreenHere</Product>
    <Description>ScreenHere</Description>
    <Copyright>MIT License</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Windows Forms is only here for the tray icon; the manifest is what sets the DPI awareness of a WPF app. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and Windows Forms both define Application, Clipboard, Point…:
         Windows Forms is only here for the tray icon and is named in full. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\ScreenHere.ico" />
    <InternalsVisibleTo Include="ScreenHere.Tests" />
  </ItemGroup>

</Project>
