<Application x:Class="ScreenHere.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- The colours come from Theme.cs, which follows Windows' light and dark modes. -->
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- One template for every hand-drawn button: a rounded surface whose
             radius is the style's Tag. -->
        <ControlTemplate x:Key="SoftButton" TargetType="ButtonBase">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
        </ControlTemplate>

        <Style x:Key="Soft" TargetType="ButtonBase">
            <Setter Property="Template" Value="{StaticResource SoftButton}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Primary}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="700" />
        </Style>

        <!-- One per shortcut; the whole tile switches its feature. -->
        <Style x:Key="Tile" TargetType="Button" BasedOn="{StaticResource Soft}">
            <Setter Property="Tag"><Setter.Value><CornerRadius>12</CornerRadius></Setter.Value></Setter>
            <Setter Property="Height" Value="50" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Background" Value="{DynamicResource P05}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource P085}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A row of the options that does something when clicked. -->
        <Style x:Key="Row" TargetType="Button" BasedOn="{StaticResource Soft}">
            <Setter Property="Tag"><Setter.Value><CornerRadius>6</CornerRadius></Setter.Value></Setter>
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="6,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource P07}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Round" TargetType="Button" BasedOn="{StaticResource Soft}">
            <Setter Property="Tag"><Setter.Value><CornerRadius>13</CornerRadius></Setter.Value></Setter>
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource P06}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource P12}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource Soft}">
            <Setter Property="Tag"><Setter.Value><CornerRadius>7</CornerRadius></Setter.Value></Setter>
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource P07}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource Soft}">
            <Setter Property="Tag"><Setter.Value><CornerRadius>10</CornerRadius></Setter.Value></Setter>
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Background" Value="{DynamicResource P06}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource P12}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The small buttons of the history's footer. -->
        <Style x:Key="Footer" TargetType="Button" BasedOn="{StaticResource Soft}">
            <Setter Property="Tag"><Setter.Value><CornerRadius>6</CornerRadius></Setter.Value></Setter>
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource P10}" />
                    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Destructive" TargetType="Button" BasedOn="{StaticResource Soft}">
            <Setter Property="Tag"><Setter.Value><CornerRadius>6</CornerRadius></Setter.Value></Setter>
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource Danger}" />
            <Setter Property="Opacity" Value="0.9" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The buttons on the history's selected row, white on the brand colour. -->
        <Style x:Key="OnBrand" TargetType="Button" BasedOn="{StaticResource Soft}">
            <Setter Property="Tag"><Setter.Value><CornerRadius>10</CornerRadius></Setter.Value></Setter>
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#38FFFFFF" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="700" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border CornerRadius="8" Background="{DynamicResource P12}" />
                            <Border x:Name="On" CornerRadius="8" Background="{DynamicResource Brand}" Opacity="0" />
                            <Border x:Name="Knob" Width="20" Height="12" CornerRadius="6" Background="White"
                                    HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="0.5" Direction="270" Opacity="0.3" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Knob" Property="Margin" Value="12,0,0,0" />
                                <Setter TargetName="On" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource P12}" BorderThickness="1"
                                CornerRadius="6" Padding="8,5" MaxWidth="250" Margin="4">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Grid Margin="14">
                            <Border CornerRadius="8" Background="{DynamicResource Card}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.28" />
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="8" Background="{DynamicResource Card}" BorderBrush="{DynamicResource P12}"
                                    BorderThickness="1" Padding="4" MinWidth="170">
                                <StackPanel IsItemsHost="True" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Surface" CornerRadius="5" Padding="9,5" Background="Transparent">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brand}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="9,4" Background="{DynamicResource P10}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A thin scroll bar that stays out of the list's way. -->
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="5" CornerRadius="2.5" Background="{DynamicResource P20}" Margin="0,3" HorizontalAlignment="Center" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
